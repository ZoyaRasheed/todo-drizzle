# ============================================
# ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and customize
# SECURITY WARNING: Never commit .env to version control!

# ============================================
# CORE CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ============================================
# JWT AUTHENTICATION (Required)
# ============================================
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-recommended
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-different-from-jwt-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# PASSWORD HASHING
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# RESPONSE ENCRYPTION (Optional)
# ============================================
RESPONSE_ENCRYPTION_KEY=express-template-default-key-32